{
  "expo": {
    "name": "Vaultly",
    "slug": "personalvault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "myvault",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1234"
    },
    "ios": {
      "bundleIdentifier": "com.gabrielthomas.vaultly"
    },
    "android": {
      "package": "com.gabrielthomas.vaultly",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1234"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "myvault" }],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "SEND",
          "data": [{ "mimeType": "*/*" }],
          "category": ["DEFAULT"]
        },
        {
          "action": "SEND_MULTIPLE",
          "data": [{ "mimeType": "*/*" }],
          "category": ["DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-camera",
        { "cameraPermission": "Allow camera access to scan documents" }
      ],
      "expo-local-authentication",
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 100,
            "NSExtensionActivationSupportsMovieWithMaxCount": 100,
            "NSExtensionActivationSupportsFileWithMaxCount": 100
          },
          "androidIntentFilters": ["text/*", "image/*", "video/*", "application/*", "*/*"]
        }
      ]
    ]
  }
}